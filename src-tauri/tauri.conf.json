{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SINGULARIS",
  "version": "2.5.0",
  "identifier": "com.dotdok.singularis",
  "build": {
    "beforeDevCommand": "npm run prepare-dist",
    "beforeBuildCommand": "npm run prepare-dist",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SINGULARIS — Gravity Architect",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
